[TEMPLATE]
# ============================================
# AssetFlow Frontend - Environment Configuration
# ============================================
# Copy this file to .env.local for development, or set these
# variables in Netlify (Site configuration → Environment variables).

# Base URL of the AssetFlow backend API.
# NOT a secret — VITE_* variables ship inside the public JS bundle.
# Local development:
VITE_API_URL=http://localhost:5000/api/v1
# Production (Render web service):
#   VITE_API_URL=https://<your-render-service>.onrender.com/api/v1
