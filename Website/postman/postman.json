{
  "info": {
    "name": "AssetFlow Website",
    "description": "Deployment smoke-test collection for the AssetFlow frontend (React 19 + Vite SPA on Netlify) — SPA routing, security headers, cache rules, and frontend-to-API wiring. Mirrors the AssetFlow API collection in server/postman/. Before running: set baseUrl to your Netlify site URL (or http://localhost:3000 for local dev — see vite.config.ts server.port) and apiUrl/apiHost to your Render backend URL (same value as VITE_API_URL in the Netlify UI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "assetflow-website-collection"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-site-name.netlify.app",
      "type": "string"
    },
    {
      "key": "apiUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "apiHost",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Site Health",
      "description": "Basic smoke checks — the SPA shell loads from the deployed site root",
      "item": [
        {
          "name": "Get Homepage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Content-Type is HTML', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "pm.test('React root mount point is present', function () {",
                  "    pm.expect(pm.response.text()).to.include('<div id=\"root\">');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Load the root of the deployed site. Returns the index.html SPA shell served by Netlify."
          },
          "response": []
        }
      ]
    },
    {
      "name": "SPA Routing",
      "description": "Deep-link checks — the Netlify redirect rule /* → /index.html (200) must serve the shell for client-side routes so React Router can take over",
      "item": [
        {
          "name": "Deep Link — /login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deep link returns 200 (not 404)', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('SPA shell is served instead of an error page', function () {",
                  "    pm.expect(pm.response.text()).to.include('<div id=\"root\">');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Open the login route directly. Netlify rewrites it to index.html with status 200 so React Router renders /login."
          },
          "response": []
        },
        {
          "name": "Deep Link — /dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deep link returns 200 (not 404)', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('SPA shell is served instead of an error page', function () {",
                  "    pm.expect(pm.response.text()).to.include('<div id=\"root\">');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            },
            "description": "Open an authenticated route directly. Should serve the SPA shell with 200; the app then redirects to login if no session exists."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Security Headers",
      "description": "Security headers configured in Website/netlify.toml for every /* response",
      "item": [
        {
          "name": "Check Security Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Frame-Options is DENY', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "pm.test('X-Content-Type-Options is nosniff', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "pm.test('Referrer-Policy is present', function () {",
                  "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.not.be.undefined;",
                  "});",
                  "pm.test('Permissions-Policy is present', function () {",
                  "    pm.expect(pm.response.headers.get('Permissions-Policy')).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Verify the netlify.toml [[headers]] block: X-Frame-Options: DENY, X-Content-Type-Options: nosniff, Referrer-Policy and Permissions-Policy on all routes."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Caching",
      "description": "Cache-Control rules from Website/netlify.toml — revalidate HTML, immutable hashed assets",
      "item": [
        {
          "name": "HTML Cache-Control",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('HTML is always revalidated', function () {",
                  "    var cacheControl = pm.response.headers.get('Cache-Control');",
                  "    pm.expect(cacheControl).to.include('max-age=0');",
                  "    pm.expect(cacheControl).to.include('must-revalidate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "index.html must be revalidated on every visit so new deploys are picked up immediately."
          },
          "response": []
        },
        {
          "name": "Immutable Asset Cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Asset is cached as immutable for one year', function () {",
                  "    var cacheControl = pm.response.headers.get('Cache-Control');",
                  "    pm.expect(cacheControl).to.include('max-age=31536000');",
                  "    pm.expect(cacheControl).to.include('immutable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/assets/:file",
              "host": ["{{baseUrl}}"],
              "path": ["assets", ":file"],
              "variable": [
                {
                  "key": "file",
                  "value": "index-abc123.js",
                  "description": "Hashed bundle filename from the latest deploy (see dist/assets/ after vite build)"
                }
              ]
            },
            "description": "Vite-hashed bundles under /assets/* get Cache-Control: public, max-age=31536000, immutable from netlify.toml."
          },
          "response": []
        }
      ]
    },
    {
      "name": "API Wiring",
      "description": "Frontend-to-backend wiring — VITE_API_URL is configured in the Netlify UI (not committed) and must point at the Render API base with the /api/v1 path",
      "item": [
        {
          "name": "Verify Backend Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('API reports healthy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.message).to.include('running');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{apiHost}}/api/health",
              "host": ["{{apiHost}}"],
              "path": ["api", "health"]
            },
            "description": "Confirm the Render backend the website talks to is up and healthy."
          },
          "response": []
        },
        {
          "name": "CORS Preflight Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Preflight is accepted', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Site origin is allowed by the API', function () {",
                  "    var allowOrigin = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "    pm.expect(allowOrigin).to.eql(pm.collectionVariables.get('baseUrl'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "content-type"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/auth/login",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Browser preflight for the login call from the deployed site. Verifies the comma-separated CLIENT_URL list on Render includes this site's URL (including the www / custom-domain variant)."
          },
          "response": []
        }
      ]
    }
  ]
}
